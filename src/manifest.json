{
  "manifest_version": 3,
  "name": "Curated Plugin",
  "version": "1.0.0",
  "description": "在 JavDB、Jable 和 MissAV 页面检查 Curated 入库状态并加入愿望单",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Curated Plugin"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://javdb.com/*", "https://jable.tv/*", "https://www.jable.tv/*", "https://*.missav.ws/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
